# Copy to .env (never commit .env)
# Used by the Pipeline page to load real GitHub Actions runs. Format: owner/repo (the repo must be public).
# For `npm run dev`, put this line in frontend/.env. For docker compose, put it in the root .env.
# In CI it is set automatically from github.repository. If unset, the page shows clearly-labelled sample data.
VITE_GITHUB_REPO=your-username/your-repo
# Added in later stages:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# GITHUB_TOKEN=
